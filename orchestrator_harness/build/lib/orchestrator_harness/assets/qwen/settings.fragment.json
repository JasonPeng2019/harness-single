{
  "hooks": {
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "name": "orchestrator-harness-notification",
            "command": "python .qwen/hooks/orchestrator_harness_notification.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "name": "orchestrator-harness-post-tool-use",
            "command": "python .qwen/hooks/orchestrator_harness_post_tool_use.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "orchestrator-harness-stop",
            "command": "python .qwen/hooks/orchestrator_harness_stop.py"
          }
        ]
      }
    ]
  }
}
