{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"required":["stable_test_id","action","dependency_fingerprint","build_provenance","behavioral_oracle","evidence_chain","outcome","failure_route"],"properties":{"stable_test_id":{"enum":["H00","H01","H02","H05","S10","S11","S12","S13","A21","A23","A24","D30","D31","D32","D33","D34","D35","D36"]},"action":{"type":"string","minLength":1,"maxLength":64},"dependency_fingerprint":{"type":"string","pattern":"^[a-f0-9]{64}$"},"build_provenance":{"type":"object","additionalProperties":false,"required":["source_commit","toolchain_lock_sha256","artifact_sha256","build_command_sha256"],"properties":{"source_commit":{"type":"string","pattern":"^[a-f0-9]{40}$"},"toolchain_lock_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"artifact_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"build_command_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},"behavioral_oracle":{"type":"object","additionalProperties":false,"required":["name","observed","expected"],"properties":{"name":{"type":"string","minLength":1},"observed":{},"expected":{}}},"evidence_chain":{"type":"array","minItems":9,"items":{"type":"object","additionalProperties":false,"required":["stage","sha256"],"properties":{"stage":{"type":"string"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}},"outcome":{"enum":["PASS","FAIL","INDETERMINATE_EXPIRED","INDETERMINATE_TIMEOUT"]},"failure_route":{"enum":["TARGET_LOCAL_REPAIR","HARNESS_WATCHER_ABORT","AUTHORIZED_SERVER_LIMITATION"]},"server_limitation":{"type":"object","additionalProperties":false,"required":["classification","substitute","physical_certification"],"properties":{"classification":{"const":"AUTHORIZED_SERVER_LIMITATION"},"substitute":{"type":"object"},"physical_certification":{"const":{"status":"NOT_CERTIFIED"}}}}}}
